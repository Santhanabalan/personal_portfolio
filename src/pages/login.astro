---
import AuthForm from '../components/AuthForm.astro';
import Layout from '../layouts/Layout.astro';
import { auth } from '../lib/auth';

export const prerender = false;

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (session) return Astro.redirect('/profile');
---

<Layout title="Sign in | Santhanabalan" description="Sign in to your portfolio account.">
	<header class="flex items-center justify-between border-b border-[var(--ink)]/20 py-5">
		<a href="/" class="font-mono text-sm font-bold uppercase tracking-widest">SB / Portfolio</a>
		<a class="text-sm font-semibold underline decoration-2 underline-offset-4" href="/">Back home</a>
	</header>
	<main id="main-content" class="grid min-h-[calc(100svh-10rem)] place-items-center py-14">
		<section
			class="w-full max-w-md border-t-8 border-[var(--accent)] bg-[var(--surface)] p-7 shadow-[6px_6px_0_var(--ink)] sm:p-10"
		>
			<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Account access</p>
			<h1 class="mt-4 [font-family:'Bodoni_72',Didot,serif] text-4xl font-bold">Welcome.</h1>
			<p class="mt-3 leading-7 text-[var(--copy)]">Choose a trusted account to continue securely.</p>
			<AuthForm />
		</section>
	</main>
</Layout>
