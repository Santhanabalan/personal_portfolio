---
import Layout from '../layouts/Layout.astro';

const title = 'Santhanabalan | Web Developer & Edge Computing';
const description =
	'Santhanabalan is a web developer building fast, dependable web experiences and edge-native systems with Astro, TypeScript, and Cloudflare.';
const siteURL = new URL('/', Astro.site).href;
const personId = `${siteURL}#person`;
const websiteId = `${siteURL}#website`;
const socialProfiles = [
	{
		name: 'GitHub',
		url: 'https://github.com/Santhanabalan',
		label: 'Santhanabalan on GitHub',
	},
	{
		name: 'LinkedIn',
		url: 'https://in.linkedin.com/in/santhanabalan',
		label: 'Santhanabalan Vasu on LinkedIn',
	},
];
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': personId,
			name: 'Santhanabalan',
			alternateName: 'Santhanabalan Vasu',
			url: siteURL,
			jobTitle: 'Web Developer',
			sameAs: socialProfiles.map((profile) => profile.url),
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			url: siteURL,
			name: 'Santhanabalan',
			inLanguage: 'en',
			author: { '@id': personId },
		},
		{
			'@type': 'ProfilePage',
			'@id': siteURL,
			url: siteURL,
			name: title,
			description,
			isPartOf: { '@id': websiteId },
			mainEntity: { '@id': personId },
		},
	],
};

const projects = [
	{
		title: 'Edge Notes',
		description: 'A fast publishing workspace that serves technical notes from the edge.',
		stack: ['Astro', 'Cloudflare', 'TypeScript'],
		accent: 'bg-[var(--accent)]',
	},
	{
		title: 'Signal Board',
		description: 'A focused operations dashboard for tracking service health and incidents.',
		stack: ['TypeScript', 'APIs', 'Observability'],
		accent: 'bg-[var(--coral)]',
	},
	{
		title: 'Route Zero',
		description: 'An experiment in low-latency routing for globally distributed applications.',
		stack: ['Edge Workers', 'KV', 'Web Standards'],
		accent: 'bg-[var(--blue)]',
	},
];
---

<Layout title={title} description={description} indexable>
	<script
		slot="head"
		type="application/ld+json"
		is:inline
		set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
	/>
	<header class="flex items-center justify-between border-b border-[var(--ink)]/20 py-5">
		<a
			href="/"
			class="font-mono text-sm font-bold uppercase tracking-widest focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]"
		>
			SB / Portfolio
		</a>
		<nav aria-label="Primary navigation">
			<ul class="flex gap-5 text-sm font-semibold sm:gap-8">
				<li><a class="underline-offset-4 hover:underline focus-visible:underline" href="#about">About</a></li>
				<li><a class="underline-offset-4 hover:underline focus-visible:underline" href="#projects">Projects</a></li>
				<li>
					<a id="account-link" class="underline-offset-4 hover:underline focus-visible:underline" href="/login"
						>Sign in</a
					>
				</li>
			</ul>
		</nav>
	</header>

	<main id="main-content">
		<section
			class="grid min-h-[72svh] content-center gap-10 border-b border-[var(--ink)]/20 py-16 lg:grid-cols-[1fr_18rem] lg:items-end"
		>
			<div>
				<p class="mb-5 font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">
					Web developer &amp; edge systems
				</p>
				<h1
					class="max-w-4xl [font-family:'Bodoni_72',Didot,serif] text-4xl leading-tight font-bold sm:text-6xl lg:text-7xl"
				>
					Santhanabalan
				</h1>
				<p class="mt-5 max-w-2xl text-2xl leading-tight font-bold sm:text-3xl">I build for the fast side of the web.</p>
				<p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--copy)] sm:text-xl">
					Developer focused on dependable interfaces, thoughtful systems, and edge infrastructure that keeps distance
					out of the way.
				</p>
				<a
					href="#projects"
					class="mt-9 inline-flex min-h-12 items-center bg-[var(--action)] px-6 font-bold text-[var(--action-text)] transition-colors hover:bg-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]"
				>
					View selected work
				</a>
				<nav aria-label="Social profiles" class="mt-5">
					<ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
						{
							socialProfiles.map((profile) => (
								<li>
									<a
										href={profile.url}
										aria-label={profile.label}
										target="_blank"
										rel="me noopener noreferrer"
										class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4 hover:text-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]"
									>
										{profile.name}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>

			<aside class="border-l-4 border-[var(--yellow)] pl-5" aria-label="Current focus">
				<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--muted)]">Currently exploring</p>
				<p class="mt-2 text-lg font-bold">Astro, edge runtimes, and the quiet craft of performance.</p>
			</aside>
		</section>

		<section id="about" class="grid gap-8 border-b border-[var(--ink)]/20 py-20 md:grid-cols-[12rem_1fr] md:py-28">
			<h2 class="font-mono text-sm font-bold uppercase tracking-[0.18em] text-[var(--accent)]">About</h2>
			<div class="max-w-3xl">
				<p class="[font-family:'Bodoni_72',Didot,serif] text-3xl leading-tight font-bold sm:text-4xl">
					I turn complex technical problems into web experiences that feel direct, useful, and fast.
				</p>
				<p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--copy)]">
					My work sits between frontend engineering and cloud infrastructure. I care about clear architecture, resilient
					delivery, and shipping less JavaScript whenever the browser does not need it.
				</p>
			</div>
		</section>

		<section id="projects" class="py-20 md:py-28">
			<div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
				<div>
					<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Selected work</p>
					<h2 class="mt-3 [font-family:'Bodoni_72',Didot,serif] text-4xl font-bold sm:text-5xl">
						Projects in the build log
					</h2>
				</div>
				<p class="max-w-xs text-sm leading-6 text-[var(--muted)]">
					A few representative projects. Full case studies are coming next.
				</p>
			</div>

			<div class="grid gap-5 md:grid-cols-3">
				{
					projects.map((project) => (
						<article class="flex min-h-80 flex-col rounded-md border border-[var(--ink)]/20 bg-[var(--surface)] p-6 shadow-[4px_4px_0_var(--ink)]">
							<div class:list={['h-2 w-14', project.accent]} aria-hidden="true" />
							<h3 class="mt-7 text-2xl font-bold">{project.title}</h3>
							<p class="mt-4 leading-7 text-[var(--copy)]">{project.description}</p>
							<ul
								class="mt-6 flex flex-wrap gap-x-4 gap-y-2 font-mono text-xs font-bold uppercase text-[var(--muted)]"
								aria-label={`${project.title} technology stack`}
							>
								{project.stack.map((technology) => (
									<li>{technology}</li>
								))}
							</ul>
							<a
								href="https://github.com/Santhanabalan"
								class="mt-auto pt-8 font-bold underline decoration-2 underline-offset-4 hover:text-[var(--accent)] focus-visible:text-[var(--accent)]"
								target="_blank"
								rel="noreferrer"
							>
								View project <span aria-hidden="true">&rarr;</span>
							</a>
						</article>
					))
				}
			</div>
		</section>
	</main>

	<footer
		class="flex flex-col justify-between gap-3 border-t border-[var(--ink)]/20 py-8 text-sm text-[var(--muted)] sm:flex-row"
	>
		<p>&copy; {new Date().getFullYear()} Santhanabalan</p>
		<p>Built with Astro. Served with restraint.</p>
	</footer>
</Layout>

<script>
	const accountLink = document.querySelector<HTMLAnchorElement>('#account-link');

	if (accountLink) {
		fetch('/api/auth/get-session')
			.then((response) => response.json())
			.then((session) => {
				if (session?.user) {
					accountLink.href = '/profile';
					accountLink.textContent = 'Profile';
				}
			})
			.catch(() => undefined);
	}
</script>
