---
import Layout from '../layouts/Layout.astro';
import { auth } from '../lib/auth';
import { siGithub, siGoogle } from 'simple-icons';

export const prerender = false;

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect('/login');

const accounts = await auth.api.listUserAccounts({ headers: Astro.request.headers });
const oauthAccounts = accounts.filter((account) => account.providerId === 'github' || account.providerId === 'google');
const providers = [
	{
		id: 'github' as const,
		name: 'GitHub',
		path: siGithub.path,
		color: 'currentColor',
	},
	{
		id: 'google' as const,
		name: 'Google',
		path: siGoogle.path,
		color: `#${siGoogle.hex}`,
	},
];
---

<Layout title="Profile | Santhanabalan" description="Your portfolio account profile.">
	<header class="flex items-center justify-between border-b border-[var(--ink)]/20 py-5">
		<a href="/" class="font-mono text-sm font-bold uppercase tracking-widest">SB / Portfolio</a>
		<div class="flex items-center gap-5">
			{
				session.user.role === 'admin' && (
					<a class="text-sm font-bold underline decoration-2 underline-offset-4" href="/admin">
						Admin
					</a>
				)
			}
			<button id="sign-out" class="text-sm font-bold underline decoration-2 underline-offset-4" type="button"
				>Sign out</button
			>
		</div>
	</header>
	<main id="main-content" class="py-16 sm:py-24">
		<section class="grid gap-10 border-b border-[var(--ink)]/20 pb-16 md:grid-cols-[12rem_1fr]">
			<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Your profile</p>
			<div>
				<h1 class="[font-family:'Bodoni_72',Didot,serif] text-5xl leading-tight font-bold sm:text-6xl">
					Hello, {session.user.name}.
				</h1>
				<p class="mt-5 max-w-xl text-lg leading-8 text-[var(--copy)]">
					You are signed in through Better Auth, with your account and session stored in Cloudflare D1.
				</p>
			</div>
		</section>
		<section class="grid gap-6 py-12 sm:grid-cols-2">
			<div class="border-l-4 border-[var(--blue)] bg-[var(--surface)] p-6">
				<p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--muted)]">Name</p>
				<p class="mt-3 text-xl font-bold">{session.user.name}</p>
			</div>
			<div class="border-l-4 border-[var(--coral)] bg-[var(--surface)] p-6">
				<p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--muted)]">Email</p>
				<p class="mt-3 break-all text-xl font-bold">{session.user.email}</p>
			</div>
		</section>

		<section class="border-t border-[var(--ink)]/20 py-12">
			<div class="max-w-2xl">
				<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Connected accounts</p>
				<h2 class="mt-3 [font-family:'Bodoni_72',Didot,serif] text-4xl font-bold">Sign-in providers</h2>
				<p class="mt-3 leading-7 text-[var(--copy)]">
					Connect another provider for account recovery. At least one provider must remain linked.
				</p>
			</div>

			<p
				id="provider-message"
				class="mt-6 hidden border-l-4 border-[var(--coral)] pl-3 text-sm text-[var(--danger)]"
				role="alert"
			>
			</p>

			<div class="mt-8 grid gap-5 sm:grid-cols-2">
				{
					providers.map((provider) => {
						const account = oauthAccounts.find((candidate) => candidate.providerId === provider.id);
						const connected = Boolean(account);
						const canUnlink = connected && oauthAccounts.length > 1;
						return (
							<article class="flex min-h-44 flex-col border border-[var(--ink)]/20 bg-[var(--surface)] p-6">
								<div class="flex items-center justify-between gap-4">
									<div class="flex items-center gap-3">
										<svg class="size-6" viewBox="0 0 24 24" fill={provider.color} aria-hidden="true">
											<path d={provider.path} />
										</svg>
										<h3 class="text-xl font-bold">{provider.name}</h3>
									</div>
									<span
										class:list={[
											'font-mono text-xs font-bold uppercase',
											connected ? 'text-[var(--accent)]' : 'text-[var(--muted)]',
										]}
									>
										{connected ? 'Connected' : 'Available'}
									</span>
								</div>
								<button
									type="button"
									data-provider-action={connected ? 'unlink' : 'link'}
									data-provider={provider.id}
									data-account-id={account?.id}
									disabled={connected && !canUnlink}
									class="mt-auto min-h-11 border border-[var(--ink)]/30 px-4 font-bold hover:border-[var(--accent)] hover:text-[var(--accent)] disabled:cursor-not-allowed disabled:opacity-40"
								>
									{connected
										? canUnlink
											? `Unlink ${provider.name}`
											: 'Required for sign in'
										: `Connect ${provider.name}`}
								</button>
							</article>
						);
					})
				}
			</div>
		</section>
	</main>
</Layout>

<script>
	import { createAuthClient } from 'better-auth/client';

	const signOutButton = document.querySelector<HTMLButtonElement>('#sign-out');
	const providerMessage = document.querySelector<HTMLParagraphElement>('#provider-message');
	const authClient = createAuthClient();
	const errorProvider = new URLSearchParams(window.location.search).get('error');
	if (errorProvider && providerMessage) {
		providerMessage.textContent = `${errorProvider === 'google' ? 'Google' : 'GitHub'} could not be connected. Please try again.`;
		providerMessage.classList.remove('hidden');
	}

	signOutButton?.addEventListener('click', async () => {
		signOutButton.setAttribute('disabled', '');
		await authClient.signOut();
		window.location.assign('/login');
	});

	document.querySelectorAll<HTMLButtonElement>('[data-provider-action]').forEach((button) => {
		button.addEventListener('click', async () => {
			const provider = button.dataset.provider as 'github' | 'google';
			const action = button.dataset.providerAction;
			providerMessage?.classList.add('hidden');
			button.setAttribute('disabled', '');

			if (action === 'link') {
				const result = await authClient.linkSocial({
					provider,
					callbackURL: '/profile',
					errorCallbackURL: `/profile?error=${provider}`,
				});
				if (!result.error) return;
				if (providerMessage)
					providerMessage.textContent = result.error.message ?? 'The provider could not be connected.';
			} else {
				const accountId = button.dataset.accountId;
				if (!accountId || !window.confirm(`Unlink ${provider} from your account?`)) {
					button.removeAttribute('disabled');
					return;
				}
				const result = await authClient.unlinkAccount({ accountId });
				if (!result.error) {
					window.location.reload();
					return;
				}
				if (providerMessage)
					providerMessage.textContent = result.error.message ?? 'The provider could not be unlinked.';
			}

			providerMessage?.classList.remove('hidden');
			button.removeAttribute('disabled');
		});
	});
</script>
