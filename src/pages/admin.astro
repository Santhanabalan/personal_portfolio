---
import Layout from '../layouts/Layout.astro';
import { auth } from '../lib/auth';
import { env } from 'cloudflare:workers';

export const prerender = false;

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect('/login');
if (session.user.role !== 'admin') return Astro.redirect('/profile');

const searchQuery = Astro.url.searchParams.get('q')?.trim().slice(0, 100) ?? '';
const searchField = Astro.url.searchParams.get('field') === 'email' ? 'email' : 'name';
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const currentPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const pageSize = 10;

const result = await auth.api.listUsers({
	headers: Astro.request.headers,
	query: {
		limit: pageSize,
		offset: (currentPage - 1) * pageSize,
		sortBy: 'createdAt',
		sortDirection: 'desc',
		...(searchQuery
			? {
					searchValue: searchQuery,
					searchField,
					searchOperator: 'contains' as const,
				}
			: {}),
	},
});

const totalPages = Math.max(1, Math.ceil(result.total / pageSize));
const buildPageUrl = (page: number) => {
	const params = new URLSearchParams();
	if (searchQuery) {
		params.set('q', searchQuery);
		params.set('field', searchField);
	}
	if (page > 1) params.set('page', String(page));
	const query = params.toString();
	return query ? `/admin?${query}` : '/admin';
};

if (currentPage > totalPages) return Astro.redirect(buildPageUrl(totalPages));

const firstResult = result.total === 0 ? 0 : (currentPage - 1) * pageSize + 1;
const lastResult = Math.min(currentPage * pageSize, result.total);

interface ProviderRow {
	userId: string;
	providerId: string;
}

const providersByUser = new Map<string, string[]>();
if (result.users.length > 0) {
	const placeholders = result.users.map(() => '?').join(', ');
	const providerResult = await env.DB.prepare(
		`select "userId", "providerId" from "account"
		where "userId" in (${placeholders}) and "providerId" in ('github', 'google')
		order by "providerId"`,
	)
		.bind(...result.users.map((user) => user.id))
		.all<ProviderRow>();
	for (const row of providerResult.results) {
		const providers = providersByUser.get(row.userId) ?? [];
		providers.push(row.providerId);
		providersByUser.set(row.userId, providers);
	}
}

interface AuditRecord {
	id: string;
	action: string;
	reason: string | null;
	status: string;
	createdAt: number;
	actorName: string | null;
	targetName: string | null;
}

const database = env.DB;
const auditResult = await database
	.prepare(
		`select log."id", log."action", log."reason", log."status", log."createdAt",
			actor."name" as "actorName", target."name" as "targetName"
		from "adminAuditLog" as log
		left join "user" as actor on actor."id" = log."actorUserId"
		left join "user" as target on target."id" = log."targetUserId"
		order by log."createdAt" desc
		limit 20`,
	)
	.all<AuditRecord>();

const sessionsByUser = new Map(
	await Promise.all(
		result.users.map(async (user) => {
			const userSessions = await auth.api.listUserSessions({
				headers: Astro.request.headers,
				body: { userId: user.id },
			});
			return [user.id, userSessions.sessions] as const;
		}),
	),
);

const formatActivity = (value: Date | string | number) =>
	new Intl.DateTimeFormat('en', {
		dateStyle: 'medium',
		timeStyle: 'short',
	}).format(new Date(value));

const getLatestActivity = (sessions: Array<{ updatedAt: Date | string }>) => {
	let latest: Date | string | null = null;
	for (const current of sessions) {
		if (!latest || new Date(current.updatedAt).getTime() > new Date(latest).getTime()) latest = current.updatedAt;
	}
	return latest;
};
---

<Layout title="Admin | Santhanabalan" description="Manage portfolio user access.">
	<header class="flex items-center justify-between border-b border-[var(--ink)]/20 py-5">
		<a href="/" class="font-mono text-sm font-bold uppercase tracking-widest">SB / Portfolio</a>
		<a class="text-sm font-bold underline decoration-2 underline-offset-4" href="/profile">Your profile</a>
	</header>
	<main id="main-content" class="py-14 sm:py-20">
		<section class="flex flex-col justify-between gap-6 border-b border-[var(--ink)]/20 pb-10 sm:flex-row sm:items-end">
			<div>
				<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Access control</p>
				<h1 class="mt-3 [font-family:'Bodoni_72',Didot,serif] text-5xl font-bold sm:text-6xl">User administration</h1>
			</div>
			<p class="font-mono text-sm text-[var(--copy)]">{result.total} {result.total === 1 ? 'account' : 'accounts'}</p>
		</section>

		<form
			method="get"
			action="/admin"
			class="mt-8 grid gap-3 border border-[var(--ink)]/20 bg-[var(--surface)] p-4 sm:grid-cols-[1fr_10rem_auto_auto] sm:items-end"
		>
			<label>
				<span class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.12em] text-[var(--muted)]"
					>Search users</span
				>
				<input
					type="search"
					name="q"
					value={searchQuery}
					maxlength="100"
					placeholder={searchField === 'email' ? 'email@example.com' : 'Name'}
					class="min-h-11 w-full border border-[var(--ink)]/30 bg-[var(--page)] px-3 outline-none focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20"
				/>
			</label>
			<label>
				<span class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.12em] text-[var(--muted)]"
					>Search by</span
				>
				<select
					name="field"
					class="min-h-11 w-full border border-[var(--ink)]/30 bg-[var(--page)] px-3 outline-none focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20"
				>
					<option value="name" selected={searchField === 'name'}>Name</option>
					<option value="email" selected={searchField === 'email'}>Email</option>
				</select>
			</label>
			<button type="submit" class="min-h-11 bg-[var(--action)] px-5 font-bold text-[var(--action-text)]">Search</button>
			{
				searchQuery ? (
					<a
						href="/admin"
						class="inline-flex min-h-11 items-center justify-center px-3 font-bold underline underline-offset-4"
					>
						Clear
					</a>
				) : (
					<span aria-hidden="true" />
				)
			}
		</form>

		<p
			id="admin-message"
			class="mt-6 hidden border-l-4 border-[var(--coral)] pl-3 text-sm text-[var(--danger)]"
			role="alert"
		>
		</p>

		<div class="mt-8 overflow-x-auto border border-[var(--ink)]/20 bg-[var(--surface)]">
			<table class="w-full min-w-[68rem] border-collapse text-left">
				<thead class="border-b border-[var(--ink)]/20 bg-[var(--action)] text-[var(--action-text)]">
					<tr class="font-mono text-xs uppercase tracking-[0.12em]">
						<th class="px-5 py-4" scope="col">User</th>
						<th class="px-5 py-4" scope="col">Role</th>
						<th class="px-5 py-4" scope="col">Providers</th>
						<th class="px-5 py-4" scope="col">Sessions</th>
						<th class="px-5 py-4" scope="col">Status</th>
						<th class="px-5 py-4 text-right" scope="col">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-[var(--ink)]/15">
					{
						result.users.length === 0 ? (
							<tr>
								<td colspan="6" class="px-5 py-12 text-center text-[var(--muted)]">
									No users match this search.
								</td>
							</tr>
						) : (
							result.users.map((user) => {
								const isCurrentUser = user.id === session.user.id;
								const isAdmin = user.role === 'admin';
								const userSessions = sessionsByUser.get(user.id) ?? [];
								const latestActivity = getLatestActivity(userSessions);
								return (
									<tr>
										<td class="px-5 py-5">
											<p class="font-bold">
												{user.name}
												{isCurrentUser && <span class="ml-2 font-mono text-xs text-[var(--accent)]">YOU</span>}
											</p>
											<p class="mt-1 text-sm text-[var(--muted)]">{user.email}</p>
										</td>
										<td class="px-5 py-5">
											<span class="font-mono text-xs font-bold uppercase">{user.role ?? 'user'}</span>
										</td>
										<td class="px-5 py-5">
											<div class="flex flex-wrap gap-2">
												{(providersByUser.get(user.id) ?? []).length > 0 ? (
													(providersByUser.get(user.id) ?? []).map((provider) => (
														<span class="border border-[var(--ink)]/20 px-2 py-1 font-mono text-xs font-bold uppercase">
															{provider}
														</span>
													))
												) : (
													<span class="font-mono text-xs text-[var(--danger)]">None</span>
												)}
											</div>
										</td>
										<td class="px-5 py-5">
											<p class="font-mono text-xs font-bold">{userSessions.length} active</p>
											<p class="mt-1 text-xs text-[var(--muted)]">
												{latestActivity ? formatActivity(latestActivity) : 'No recent activity'}
											</p>
										</td>
										<td class="px-5 py-5">
											<span
												class:list={[
													'font-mono text-xs font-bold uppercase',
													user.banned ? 'text-[var(--danger-strong)]' : 'text-[var(--accent)]',
												]}
											>
												{user.banned ? 'Banned' : 'Active'}
											</span>
										</td>
										<td class="px-5 py-5">
											<div class="flex justify-end gap-3" data-user-id={user.id}>
												<button
													type="button"
													data-action="role"
													data-role={isAdmin ? 'user' : 'admin'}
													disabled={isCurrentUser}
													class="border border-[var(--ink)]/30 px-3 py-2 text-sm font-bold disabled:cursor-not-allowed disabled:opacity-40"
												>
													{isAdmin ? 'Make user' : 'Make admin'}
												</button>
												<button
													type="button"
													data-action={user.banned ? 'unban' : 'ban'}
													disabled={isCurrentUser}
													class="border border-[var(--ink)]/30 px-3 py-2 text-sm font-bold disabled:cursor-not-allowed disabled:opacity-40"
												>
													{user.banned ? 'Unban' : 'Ban'}
												</button>
												<button
													type="button"
													data-action="sessions"
													disabled={isCurrentUser || userSessions.length === 0}
													class="border border-[var(--ink)]/30 px-3 py-2 text-sm font-bold disabled:cursor-not-allowed disabled:opacity-40"
												>
													Revoke sessions
												</button>
											</div>
										</td>
									</tr>
								);
							})
						)
					}
				</tbody>
			</table>
		</div>

		<nav class="mt-6 flex items-center justify-between gap-4" aria-label="User results pagination">
			<p class="font-mono text-xs text-[var(--muted)]">Showing {firstResult}-{lastResult} of {result.total}</p>
			<div class="flex items-center gap-3">
				{
					currentPage > 1 ? (
						<a class="border border-[var(--ink)]/30 px-4 py-2 text-sm font-bold" href={buildPageUrl(currentPage - 1)}>
							Previous
						</a>
					) : (
						<span class="border border-[var(--ink)]/15 px-4 py-2 text-sm font-bold opacity-40">Previous</span>
					)
				}
				<span class="font-mono text-xs">Page {currentPage} of {totalPages}</span>
				{
					currentPage < totalPages ? (
						<a class="border border-[var(--ink)]/30 px-4 py-2 text-sm font-bold" href={buildPageUrl(currentPage + 1)}>
							Next
						</a>
					) : (
						<span class="border border-[var(--ink)]/15 px-4 py-2 text-sm font-bold opacity-40">Next</span>
					)
				}
			</div>
		</nav>

		<section class="mt-16 border-t border-[var(--ink)]/20 pt-10">
			<div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
				<div>
					<p class="font-mono text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Audit trail</p>
					<h2 class="mt-2 [font-family:'Bodoni_72',Didot,serif] text-4xl font-bold">Recent admin activity</h2>
				</div>
				<p class="font-mono text-xs text-[var(--muted)]">Latest 20 attempts</p>
			</div>

			<div class="mt-6 overflow-x-auto border border-[var(--ink)]/20 bg-[var(--surface)]">
				<table class="w-full min-w-[44rem] border-collapse text-left">
					<thead class="bg-[var(--action)] text-[var(--action-text)]">
						<tr class="font-mono text-xs uppercase tracking-[0.12em]">
							<th class="px-5 py-4" scope="col">When</th>
							<th class="px-5 py-4" scope="col">Actor</th>
							<th class="px-5 py-4" scope="col">Action</th>
							<th class="px-5 py-4" scope="col">Target</th>
							<th class="px-5 py-4" scope="col">Outcome</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-[var(--ink)]/15">
						{
							auditResult.results.length === 0 ? (
								<tr>
									<td colspan="5" class="px-5 py-10 text-center text-[var(--muted)]">
										No administrative actions recorded yet.
									</td>
								</tr>
							) : (
								auditResult.results.map((entry) => (
									<tr>
										<td class="px-5 py-4 text-sm text-[var(--muted)]">{formatActivity(entry.createdAt)}</td>
										<td class="px-5 py-4 font-bold">{entry.actorName ?? 'Deleted user'}</td>
										<td class="px-5 py-4">
											<p class="font-mono text-xs font-bold uppercase">{entry.action}</p>
											{entry.reason && <p class="mt-1 text-xs text-[var(--muted)]">{entry.reason}</p>}
										</td>
										<td class="px-5 py-4 font-bold">{entry.targetName ?? 'Deleted user'}</td>
										<td class="px-5 py-4">
											<span
												class:list={[
													'font-mono text-xs font-bold uppercase',
													entry.status === 'succeeded' ? 'text-[var(--accent)]' : 'text-[var(--danger-strong)]',
												]}
											>
												{entry.status}
											</span>
										</td>
									</tr>
								))
							)
						}
					</tbody>
				</table>
			</div>
		</section>
	</main>
</Layout>

<script>
	const message = document.querySelector<HTMLParagraphElement>('#admin-message');

	document.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((button) => {
		button.addEventListener('click', async () => {
			const container = button.closest<HTMLElement>('[data-user-id]');
			const userId = container?.dataset.userId;
			const action = button.dataset.action;
			if (!userId || !action) return;

			if (action === 'ban' && !window.confirm('Ban this user and revoke their active sessions?')) return;
			if (action === 'sessions' && !window.confirm('Revoke every active session for this user?')) return;
			button.setAttribute('disabled', '');
			message?.classList.add('hidden');

			const response = await fetch(`/api/admin/users/${encodeURIComponent(userId)}`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ action, role: button.dataset.role }),
			});
			const result = await response.json<{ success?: boolean; error?: string }>();

			if (!response.ok || result.error) {
				if (message) {
					message.textContent = result.error.message ?? 'The access change could not be completed.';
					message.classList.remove('hidden');
				}
				button.removeAttribute('disabled');
				return;
			}

			window.location.reload();
		});
	});
</script>
