---
import octicons from '@primer/octicons';

interface Props {
	mode: 'login' | 'signup';
}

const { mode } = Astro.props;
const isSignup = mode === 'signup';
const githubIcon = octicons['mark-github'].toSVG({ width: 20, fill: 'currentColor' });
---

<div class="mt-10">
	<button
		id="github-auth"
		type="button"
		class="inline-flex min-h-12 w-full items-center justify-center gap-3 bg-[var(--action)] px-6 font-bold text-[var(--action-text)] transition-colors hover:bg-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)] disabled:cursor-wait disabled:opacity-60"
	>
		<Fragment set:html={githubIcon} />
		<span id="github-auth-label">Continue with GitHub</span>
	</button>
	<div class="my-6 flex items-center gap-4" aria-hidden="true">
		<span class="h-px flex-1 bg-[var(--ink)]/20"></span>
		<span class="font-mono text-xs uppercase text-[var(--muted)]">or use email</span>
		<span class="h-px flex-1 bg-[var(--ink)]/20"></span>
	</div>
</div>

<form id="auth-form" data-mode={mode} class="space-y-5">
	{
		isSignup && (
			<label class="block">
				<span class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--copy)]">Name</span>
				<input
					class="min-h-12 w-full rounded-none border border-[var(--ink)]/30 bg-[var(--surface)] px-4 outline-none transition focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20"
					type="text"
					name="name"
					autocomplete="name"
					required
				/>
			</label>
		)
	}
	<label class="block">
		<span class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--copy)]">Email</span>
		<input
			class="min-h-12 w-full rounded-none border border-[var(--ink)]/30 bg-[var(--surface)] px-4 outline-none transition focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20"
			type="email"
			name="email"
			autocomplete="email"
			required
		/>
	</label>
	<label class="block">
		<span class="mb-2 block font-mono text-xs font-bold uppercase tracking-[0.14em] text-[var(--copy)]">Password</span>
		<input
			class="min-h-12 w-full rounded-none border border-[var(--ink)]/30 bg-[var(--surface)] px-4 outline-none transition focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20"
			type="password"
			name="password"
			autocomplete={isSignup ? 'new-password' : 'current-password'}
			minlength="8"
			required
		/>
	</label>
	<p id="auth-error" class="hidden border-l-4 border-[var(--coral)] pl-3 text-sm text-[var(--danger)]" role="alert"></p>
	<button
		type="submit"
		class="inline-flex min-h-12 w-full items-center justify-center bg-[var(--action)] px-6 font-bold text-[var(--action-text)] transition-colors hover:bg-[var(--accent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)] disabled:cursor-wait disabled:opacity-60"
	>
		{isSignup ? 'Create account' : 'Sign in'}
	</button>
</form>

<script>
	import { createAuthClient } from 'better-auth/client';

	const form = document.querySelector<HTMLFormElement>('#auth-form');
	const errorMessage = document.querySelector<HTMLParagraphElement>('#auth-error');
	const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const githubButton = document.querySelector<HTMLButtonElement>('#github-auth');
	const githubButtonLabel = document.querySelector<HTMLSpanElement>('#github-auth-label');
	const authClient = createAuthClient();

	githubButton?.addEventListener('click', async () => {
		errorMessage?.classList.add('hidden');
		githubButton.setAttribute('disabled', '');
		if (githubButtonLabel) githubButtonLabel.textContent = 'Connecting to GitHub...';

		const result = await authClient.signIn.social({
			provider: 'github',
			callbackURL: '/profile',
			errorCallbackURL: '/login?error=github',
		});

		if (result.error) {
			if (errorMessage) {
				errorMessage.textContent = result.error.message ?? 'GitHub authentication could not be started.';
				errorMessage.classList.remove('hidden');
			}
			githubButton.removeAttribute('disabled');
			if (githubButtonLabel) githubButtonLabel.textContent = 'Continue with GitHub';
		}
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		errorMessage?.classList.add('hidden');
		submitButton?.setAttribute('disabled', '');

		const formData = new FormData(form);
		const email = String(formData.get('email') ?? '');
		const password = String(formData.get('password') ?? '');
		const mode = form.dataset.mode;
		const result =
			mode === 'signup'
				? await authClient.signUp.email({
						name: String(formData.get('name') ?? ''),
						email,
						password,
					})
				: await authClient.signIn.email({ email, password });

		if (result.error) {
			if (errorMessage) {
				errorMessage.textContent = result.error.message ?? 'Authentication failed. Please try again.';
				errorMessage.classList.remove('hidden');
			}
			submitButton?.removeAttribute('disabled');
			return;
		}

		window.location.assign('/profile');
	});
</script>
